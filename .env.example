# ==============================================================================
# e-Challan Third-Party API Configuration
# ==============================================================================

# Set to true to enable live lookups via your third-party provider API gateway.
# When set to false or when no valid key is provided, the system falls back to demo mode.
USE_LIVE_API=false

# Base URL or endpoint for your licensed third-party e-Challan service provider.
# Example: https://api.yourprovider.com/v1/vehicle/challans
CHALLAN_API_URL=

# Secret API key / Bearer Token provided by your service vendor.
# Note: Keep this key confidential. Never commit your actual .env file.
CHALLAN_API_KEY=
